# EKWB credentials & model config (copy to .env and fill in; .env is gitignored, never commit)

# OpenAI-compatible endpoint (models under test / embeddings). For OpenAI: https://api.openai.com/v1
API_BASE=https://api.openai.com/v1
API_KEY=sk-...
# Multi-key rotation is optional: comma-separate several keys to raise throughput (rate ~= x number of keys).

# Anthropic native endpoint (Claude models under test / the judge). For Anthropic: https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=sk-ant-...

# Model selection (use identifiers your endpoint serves)
CHAT_MODEL=gpt-4o-mini              # lightweight LLM (auditing / extraction)
JUDGE_MODEL=claude-opus-4-8         # judge (kept separate from the model under test to avoid self-grading)
EMBED_MODEL=Qwen/Qwen3-Embedding-8B # embedding for index building (query side auto-matches index_meta)

# Dataset layout (this release ships golden_packets.jsonl, not the default v2.2 name)
EKWB_BANK=dataset/golden_packets.jsonl
EKWB_CORPUS=dataset/corpus
# EKWB_RAG_INDEX=indexes/rag
# EKWB_BM25_INDEX=indexes/bm25

# Concurrency / timeout (optional)
LLMWIKI_MAX_CONCURRENCY=32
LLMWIKI_TIMEOUT=240

# Optional: for "thinking" open models, set 1 to disable extended thinking on single-turn pipelines
# EKWB_NO_THINK=1
